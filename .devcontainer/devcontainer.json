{
    "name": "debian-dev-container",
    "image": "mcr.microsoft.com/devcontainers/base:debian-12",

    "features": {
        "ghcr.io/devcontainers/features/python:1": { "version": "3.12" },
        "ghcr.io/devcontainers/features/node:2": {"version": "lts"},
        "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {},
        "ghcr.io/devcontainers/features/sshd:1": {}
    },

    "mounts": [
        "source=${localEnv:SSH_AUTH_SOCK},target=/ssh-agent,type=bind"
    ],
    "remoteEnv": {
        "SSH_AUTH_SOCK": "/ssh-agent"
    },

    "postCreateCommand": "curl -LsSf https://astral.sh/uv/install.sh | sh && $HOME/.local/bin/uv sync",

    "customizations": {
        "vscode": {
            "extensions": ["ms-python.python", "charliermarsh.ruff"],
            "settings": { "python.defaultInterpreterPath": "/workspaces/base_environment_template/.venv/bin/python" }
        }
    }
}
