# .env.example — same shape, committed. Recreate .env from this on a machine
# that never ran cookiecutter (a second machine, a fresh clone, a teammate).
# Local model used by SkillSpector + scripts/ask.sh
LOCAL_MODEL={{ cookiecutter.local_model }}

{%- if cookiecutter.monitoring == "yes" %}
# Monitoring — prompt/response capture is OFF unless you uncomment these.
# OTEL_LOG_USER_PROMPTS=1        # capture prompt/response text (not just numbers)
# OTEL_LOG_RAW_API_BODIES=1      # full request/response JSON, inline, truncated to 60KB
{%- endif %}